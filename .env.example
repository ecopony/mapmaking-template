# Copy to .env at the repo root and point each variable at your local data archive.
# Nothing here is secret — these are filesystem locations for bulk geospatial data
# that is too large to track in git. Load in code with:
#   dotenv.load_dotenv(dotenv.find_dotenv())

# Digital elevation models, organized however you like, e.g.
#   Copernicus/GLO-90/<tiles>.tif
# Used by: example-elevation-zones
DEM_DIR=C:/GIS/DEM

# Natural Earth shapefiles, per-theme subdirectories, e.g.
#   Countries/ne_50m_admin_0_countries/ne_50m_admin_0_countries.shp
#   StatesProvinces/ne_50m_admin_1_states_provinces_lakes/...
# Used by: shared basemap layers
NATURAL_EARTH_DIR=C:/GIS/NaturalEarth

# Catch-all for project-specific downloads.
DATA_DIR=C:/GIS/Data
